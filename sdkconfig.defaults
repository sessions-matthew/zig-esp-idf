# Target Specification (ESP32-C6 by default; change to esp32, esp32s3, esp32c3 etc. as needed)
CONFIG_IDF_TARGET="esp32c6"

# Flash Size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Console Configuration
# Primary: UART0 @ 115200 baud
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Secondary Console: USB Serial/JTAG active simultaneously
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# FreeRTOS Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y
CONFIG_FREERTOS_HZ=100
